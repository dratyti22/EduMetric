# Copy to .env.production on the SERVER. Never commit real credentials.
DOMAIN=exam.example.com
SECRET_KEY=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_64_CHARACTERS
DEBUG=0
ALLOWED_HOSTS=exam.example.com
CSRF_TRUSTED_ORIGINS=https://exam.example.com
CORS_ALLOWED_ORIGINS=https://exam.example.com

DB_NAME=edumetric
DB_USER=edumetric
DB_PASSWORD=REPLACE_WITH_RANDOM_DATABASE_PASSWORD
DB_ENGINE=django.db.backends.postgresql
DB_HOST=db
DB_PORT=5432

ACCESS_TOKEN_LIFETIME=30
REFRESH_TOKEN_LIFETIME=7
ROTATE_REFRESH_TOKENS=True
AUTH_HEADER_TYPE=Bearer
