{$DOMAIN} {
    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        X-Frame-Options DENY
        -Server
    }
    @backend path /api /api/* /admin /admin/*
    handle @backend {
        reverse_proxy backend:8000
    }
    handle_path /static/* {
        root * /srv/static
        file_server
    }
    handle {
        root * /srv/frontend
        try_files {path} /index.html
        file_server
    }
}
