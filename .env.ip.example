# Temporary HTTP-only deployment. Replace 203.0.113.10 with the public server IP.
# Copy to .env.production; do not commit real credentials.
DOMAIN=http://203.0.113.10
ALLOWED_HOSTS=203.0.113.10
CSRF_TRUSTED_ORIGINS=http://203.0.113.10
CORS_ALLOWED_ORIGINS=http://203.0.113.10
SECRET_KEY=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_64_CHARACTERS
DEBUG=0

SECURE_SSL_REDIRECT=0
SESSION_COOKIE_SECURE=0
CSRF_COOKIE_SECURE=0
SECURE_HSTS_SECONDS=0

DB_NAME=edumetric
DB_USER=edumetric
DB_PASSWORD=REPLACE_WITH_RANDOM_DATABASE_PASSWORD
DB_ENGINE=django.db.backends.postgresql
DB_HOST=db
DB_PORT=5432

ACCESS_TOKEN_LIFETIME=30
REFRESH_TOKEN_LIFETIME=7
ROTATE_REFRESH_TOKENS=True
AUTH_HEADER_TYPE=Bearer
